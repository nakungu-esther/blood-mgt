import { useState } from 'react';
import { NavLink, Outlet, useLocation, useNavigate } from 'react-router-dom';
import { Activity, Bell, ChevronDown, ChevronRight, CircleHelp, Droplets, LogOut, Menu, PanelLeftClose, PanelLeftOpen, Search, ShieldCheck, X } from 'lucide-react';
import { modules } from '../lib/modules';
import { useAuth } from '../context/AuthContext';
const groups=[{title:'WORKSPACE',paths:['/','/analytics','/reports']},{title:'BLOOD OPERATIONS',paths:['/donors','/donations','/inventory','/laboratory','/hospital-requests','/stock-matching','/blood-transfers','/reservations','/blood-release','/transfusions']},{title:'INTELLIGENCE',paths:['/forecasting','/redistribution','/traceability']},{title:'ADMINISTRATION',paths:['/facilities','/users','/audit-logs','/notifications','/settings','/health']}];
export default function Layout(){
 const {user,logout}=useAuth();const [open,setOpen]=useState(false);const [collapsed,setCollapsed]=useState(()=>{try{return localStorage.getItem('ab-sidebar-collapsed')==='true'}catch{return false}});const toggleCollapsed=()=>setCollapsed(v=>{try{localStorage.setItem('ab-sidebar-collapsed',String(!v))}catch{}return !v});const [query,setQuery]=useState('');const [searchOpen,setSearchOpen]=useState(false);const navigate=useNavigate();const location=useLocation();
 const visible=modules.filter(m=>!m.roles||m.roles.includes(user?.role||''));const current=modules.find(m=>m.path===location.pathname);const results=visible.filter(m=>(m.title+' '+m.description).toLowerCase().includes(query.toLowerCase())).slice(0,8);
 return <div className="min-h-screen bg-[#f5f7fb] lg:flex">
 {open&&<button aria-label="Close navigation" className="fixed inset-0 z-30 bg-[#101b31]/60 lg:hidden" onClick={()=>setOpen(false)}/>}
 <aside className={`${open?'translate-x-0':'-translate-x-full'} fixed inset-y-0 left-0 z-40 flex ${collapsed?'lg:w-[82px]':'lg:w-[272px]'} w-[272px] flex-col bg-[#101d32] text-white transition-transform lg:sticky lg:top-0 lg:h-screen lg:translate-x-0`}>
 <div className={`flex items-center gap-3 border-b border-white/10 py-6 ${collapsed?'lg:px-4':'px-6'}`}><div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#cb304b] shadow-lg shadow-red-900/20"><Droplets size={25} fill="currentColor" strokeWidth={1.8}/></div><div className={`flex-1 ${collapsed?'lg:hidden':''}`}><div className="text-[20px] font-black tracking-tight">AfriBlood<span className="text-[#f68b9d]">.</span></div><div className="text-[9px] font-bold tracking-[.26em] text-slate-400">INTELLIGENCE PLATFORM</div></div><button className="lg:hidden" aria-label="Close" onClick={()=>setOpen(false)}><X size={20}/></button></div>
 <div className={`px-4 pt-5 ${collapsed?'lg:hidden':''}`}><div className="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-3 py-3"><div className="rounded-lg bg-emerald-400/10 p-2 text-emerald-300"><Activity size={16}/></div><div className="min-w-0"><div className="text-xs font-bold">Operations workspace</div><div className="text-[11px] text-slate-400">Connected data · role scoped</div></div><ChevronDown size={14} className="ml-auto text-slate-400"/></div></div>
 <nav aria-label="Primary navigation" className="subtle-scroll mt-3 flex-1 overflow-y-auto px-3 pb-5">{groups.map(group=>{const items=visible.filter(m=>group.paths.includes(m.path));return items.length?<div key={group.title} className="mt-5"><p className={`mb-2 px-4 text-[10px] font-bold tracking-[.17em] text-slate-500 ${collapsed?'lg:hidden':''}`}>{group.title}</p><div className="space-y-0.5">{items.map(({path,title,icon:Icon})=><NavLink key={path} title={collapsed?title:undefined} to={path} end={path==='/'} onClick={()=>setOpen(false)} className={({isActive})=>`group flex items-center gap-3 rounded-xl px-4 py-2.5 text-[13px] font-medium transition ${isActive?'bg-[#c42d49] text-white shadow-md shadow-black/10':'text-slate-300 hover:bg-white/[.07] hover:text-white'}`}><Icon size={17} strokeWidth={1.9}/><span className={`flex-1 ${collapsed?'lg:hidden':''}`}>{title}</span><ChevronRight size={13} className={`opacity-0 group-hover:opacity-60 ${collapsed?'lg:hidden':''}`}/></NavLink>)}</div></div>:null})}</nav>
 <div className={`border-t border-white/10 ${collapsed?'lg:p-2':'p-4'}`}><div className={`flex items-center gap-3 rounded-xl bg-white/[.06] ${collapsed?'lg:flex-col lg:p-2':'p-3'}`}><div className="flex h-9 w-9 items-center justify-center rounded-full bg-[#f3d8df] text-sm font-black text-[#9b2940]">{(user?.firstName?.[0]||user?.email?.[0]||'A').toUpperCase()}</div><div className={`min-w-0 flex-1 ${collapsed?'lg:hidden':''}`}><div className="truncate text-xs font-bold">{[user?.firstName,user?.lastName].filter(Boolean).join(' ')||user?.email}</div><div className="truncate text-[10px] text-slate-400">{user?.role?.replaceAll('_',' ')}</div></div><button onClick={logout} aria-label="Sign out" title="Sign out" className="rounded-lg p-2 text-slate-300 hover:bg-white/10"><LogOut size={17}/></button></div></div>
 </aside>
 <div className="min-w-0 flex-1"><header className="sticky top-0 z-20 flex h-[76px] items-center justify-between gap-4 border-b border-[#e8ecf2] bg-white/95 px-5 backdrop-blur lg:px-9"><div className="flex min-w-0 items-center gap-4"><button className="lg:hidden" aria-label="Open menu" onClick={()=>setOpen(true)}><Menu size={22}/></button><button className="hidden rounded-lg p-2 text-slate-500 hover:bg-slate-100 lg:inline-flex" title={collapsed?"Expand sidebar":"Collapse sidebar"} aria-label={collapsed?"Expand sidebar":"Collapse sidebar"} onClick={toggleCollapsed}>{collapsed?<PanelLeftOpen size={20}/>:<PanelLeftClose size={20}/>}</button><div className="min-w-0"><p className="truncate text-[15px] font-extrabold text-[#1b2a40]">{current?.title||'AfriBlood Intelligence'}</p><p className="hidden text-xs text-slate-400 sm:block">Blood supply network / {current?.title||'Workspace'}</p></div></div><div className="flex items-center gap-3"><button className="hidden items-center gap-2 rounded-xl border border-[#e9edf3] bg-[#f8f9fc] px-4 py-2.5 text-xs text-slate-500 md:flex" onClick={()=>{setSearchOpen(true);setQuery('')}}><Search size={16}/>Search modules <span className="ml-10 rounded border px-1.5 text-[10px]">⌘ K</span></button><button aria-label="Search" onClick={()=>setSearchOpen(true)} className="rounded-xl p-2.5 text-slate-500 md:hidden"><Search size={19}/></button><button aria-label="Notifications" title="Open notifications" onClick={()=>navigate('/notifications')} className="rounded-xl border border-[#e9edf3] p-2.5 text-slate-500"><Bell size={18}/></button><button onClick={()=>navigate('/settings')} title="Settings" className="flex h-10 w-10 items-center justify-center rounded-full bg-[#f7dce2] text-sm font-bold text-[#a72b42]">{(user?.firstName?.[0]||user?.email?.[0]||'A').toUpperCase()}</button></div></header>
 <main className="mx-auto max-w-[1600px] px-5 py-7 lg:px-9 lg:py-9"><Outlet/></main><footer className="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-2 px-5 pb-8 text-[11px] text-slate-400 lg:px-9"><span>© 2026 AfriBlood Intelligence · Operational prototype</span><span className="flex items-center gap-1.5"><ShieldCheck size={13}/> Synthetic data only · Not for clinical use</span></footer></div>
 {searchOpen&&<div className="fixed inset-0 z-50 flex items-start justify-center bg-[#101d32]/60 px-4 pt-[12vh]" onMouseDown={e=>{if(e.target===e.currentTarget)setSearchOpen(false)}}><div className="w-full max-w-xl overflow-hidden rounded-2xl bg-white shadow-2xl"><div className="flex items-center gap-3 border-b px-5 py-4"><Search size={20} className="text-slate-400"/><input autoFocus value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search pages and workflows…" className="w-full outline-none"/><button aria-label="Close search" onClick={()=>setSearchOpen(false)}><X size={18}/></button></div><div className="max-h-80 overflow-y-auto p-2">{results.length?results.map(m=><button key={m.path} onClick={()=>{navigate(m.path);setSearchOpen(false)}} className="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left hover:bg-slate-50"><m.icon size={18} className="text-[#bf3049]"/><span className="flex-1"><span className="block text-sm font-bold">{m.title}</span><span className="block text-xs text-slate-400">{m.description}</span></span><ChevronRight size={16} className="text-slate-400"/></button>):<p className="p-5 text-sm text-slate-500">No matching modules.</p>}</div><div className="flex items-center gap-2 border-t bg-slate-50 px-5 py-3 text-xs text-slate-400"><CircleHelp size={14}/> Select a module to navigate</div></div></div>}
 </div>;
}
